# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# turborepo
.turbo

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by next dev
AGENTS.md
CLAUDE.md

# embedded development database
/.data

# fg-policy build: these rules alone, for trying locally
/policies.tar.gz

# fg-dist policy use: the distribution's policy, for this build to run
/.policy

# browser tests
/e2e/.data
/test-results
/playwright-report

# Next.js build dirs at any depth: the docs site's, the NEXT_DIST_DIR ones
# parallel builds use, and any Turbopack writes outside docs/.
.next
.next-*
