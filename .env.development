# Local development defaults, loaded by `next dev` and the db/keys scripts.
# Override any of them in .env.development.local, which is not committed.
# Every variable is described in .env.example.

FG_ID_URL=http://localhost:3010
FG_ID_NAME=Fair Garden

# The members service (apps/members, on port 3020) signs in here, and supplies
# the `membership` scope's claims to any other service a person shares it with.
FG_ID_SERVICE_MEMBERS_URL=http://localhost:3020
FG_ID_SERVICE_MEMBERS_NAME=Members
FG_ID_SERVICE_MEMBERS_SECRET=dev-only-members-secret
FG_ID_SERVICE_MEMBERS_CLAIMS=membership
