# Every setting the id service reads. Only FG_ID_URL and a database are
# needed to run it; everything else has a default.

# --- Where it is served ------------------------------------------------------

# The public URL, before any monolith mount point. The OIDC issuer, passkey
# domain and email links all follow from it, so this is what white-labelling
# changes. Defaults to the Vercel deployment's own domain, else localhost:3010.
FG_ID_URL=https://id.example.com
# The name people see on every page, email and passkey prompt.
FG_ID_NAME=Example

# --- Database ------------------------------------------------------------------

# Any Postgres. Neon's Vercel integration sets DATABASE_URL, which is used when
# this is not set (as is POSTGRES_URL). Without either, development runs an
# embedded PGlite database in .data/id.
FG_ID_DATABASE_URL=postgres://user:password@host/db?sslmode=require
# FG_ID_DATABASE_POOL_SIZE=5
# FG_ID_DATA_DIR=.data/id
# FG_ID_EMBEDDED_DATABASE_PORT=54310

# --- Email -------------------------------------------------------------------

# Sign-in emails. Without it, a local host uses the mock mailbox at
# /dev/mailbox, and a public host sends nothing.
FG_ID_SMTP_URL=smtps://user:password@smtp.example.com:465
FG_ID_EMAIL_FROM=Example <no-reply@example.com>
# Force the mock mailbox on a public host, for a demo. Anyone can read it.
# FG_ID_MOCK_EMAIL=true

# --- Keys --------------------------------------------------------------------

# Token signing keys and cookie secrets live in the database and rotate by
# themselves. These take over, for keeping them in a secret store instead:
# `pnpm keys generate` prints a value, `pnpm keys rotate --env` the next one.
# FG_ID_JWKS={"keys":[...]}
# FG_ID_COOKIE_SECRETS=newest,older
# FG_ID_KEY_ROTATION_DAYS=30

# --- Passkeys ----------------------------------------------------------------

# Share passkeys across subdomains by naming the parent domain.
# FG_ID_PASSKEY_RP_ID=example.com
# More origins allowed to use them, space separated.
# FG_ID_PASSKEY_ORIGINS=https://www.example.com

# --- Services ----------------------------------------------------------------

# One group per service that signs in here. The name after FG_ID_SERVICE_
# becomes its client ID (lowercased, _ as -) unless _ID is given. A service is
# found by its _URL, or _REDIRECT_URIS for one without a site.
FG_ID_SERVICE_MEMBERS_URL=https://members.example.com
FG_ID_SERVICE_MEMBERS_SECRET=a-long-random-secret
# FG_ID_SERVICE_MEMBERS_NAME=Members
# FG_ID_SERVICE_MEMBERS_ID=members
# Default: <URL>/auth/callback, and <URL> after signing out. Space separated.
# FG_ID_SERVICE_MEMBERS_REDIRECT_URIS=https://members.example.com/auth/callback
# FG_ID_SERVICE_MEMBERS_LOGOUT_URIS=https://members.example.com
# Scopes whose claims this service supplies to others, as scope:claim,claim.
# Each is sent to its webhook as a ClaimsReview when released.
FG_ID_SERVICE_MEMBERS_CLAIMS=membership
# FG_ID_SERVICE_MEMBERS_CLAIMS_ENDPOINT=https://members.example.com/api/v1alpha1/claimsreviews
# Any other oidc-provider client metadata, as JSON.
# FG_ID_SERVICE_MEMBERS_METADATA={"id_token_signed_response_alg":"PS256"}

# A service without a secret is a public client, and must use PKCE (as every
# client must here).
# FG_ID_SERVICE_EVENTS_URL=https://events.example.com

# --- Policy ------------------------------------------------------------------

# Authorization decisions follow the organization's policy that this
# deployment was built with (`fg-dist policy use`, in the build), or id's
# built-in rules when there is none. These are shared by every service.
# A policy from elsewhere, as a path or https URL, signed by this key:
# FG_POLICY_BUNDLE=https://policy.example.org/policies.tar.gz
# FG_POLICY_PUBLIC_KEY={"kty":"EC",...}
# Or unsigned, only for trying a policy locally:
# FG_POLICY_ALLOW_UNSIGNED=true
# Or `none`, for the built-in rules whatever the build had:
# FG_POLICY_BUNDLE=none
# Or an OPA server to ask instead:
# FG_POLICY_OPA_URL=http://localhost:8181
# The Rego package the rules are in.
# FG_ID_POLICY_PACKAGE=fairgarden/id
# Every decision is recorded in the database; how long to keep them, and
# whether to write each to standard output as well, for a log drain.
# FG_ID_POLICY_LOG_RETENTION_DAYS=400
# FG_ID_POLICY_LOG_STDOUT=true
